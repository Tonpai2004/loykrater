# Firebase Realtime Database (optional)
# Copy to .env.local and replace the placeholders with values from
# Firebase Console > Project settings > Your apps.
# Keep the placeholders (or leave this file uncopied) to play offline:
# krathongs are then shared between browser tabs via BroadcastChannel.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Public site address (optional but recommended in production)
# Used for share links, the QR code on story cards and the og:image URL.
# If empty: share links use the address the visitor opened, og:image uses https://loykrater2026.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Facebook App ID (optional)
# Lets the Messenger button open the web "Send" dialog on desktop.
# Without it, desktop Messenger copies the link instead (phones always open the Messenger app).
NEXT_PUBLIC_FACEBOOK_APP_ID=
